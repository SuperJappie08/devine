export DEVINE_VERSION="0.0.0-dev"

function use-color() {
	[[ -z $NO_COLOR ]]
}

function usage() {
	local reset blue

	if use-color; then
		reset=$(tput sgr0 2>/dev/null)
		blue=$(tput setaf 6 2>/dev/null)
	fi

	cat <<-EOF
		${blue}devine$reset - A better devcontainer-cli interface - ($DEVINE_VERSION)
		Usage: devine [command] [args...]

		Subcommands:
		    ${blue}devine version$reset
		      print the version number of devine and exit
	EOF
}

function main() {
	local red reset

	if use-color; then
		reset=$(tput sgr0 2>/dev/null)
		red=$(tput setaf 1 bold 2>/dev/null)
	fi

	if ! which devcontainer &>/dev/null; then
		echo "${red}[ERROR]${reset} devcontainer executable is required!"
		exit 99
	fi

	local cmd=$1
	shift
	case "$cmd" in
		-v | v | version) echo "$DEVINE_VERSION" ;;
		*)
			usage >&2
			exit 1
			;;
	esac
}

# Do not execute when not being sourced
if ! (return 0 2>/dev/null); then
	main "$@"
fi
